{
  "name": "golden-grab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Golden Grab — first-person physics heist game.",
  "scripts": {
    "start": "npx serve . -l 5173",
    "check": "node tools/check_levels.mjs",
    "assets": "node tools/export_levels.mjs",
    "test": "node tools/test/play.mjs",
    "desktop": "electron .",
    "desktop:release": "electron . --release",
    "i18n": "node tools/check_i18n.mjs",
    "vendor": "node tools/vendor.mjs",
    "textures": "node tools/convert_textures.mjs",
    "test:desktop": "node tools/test/desktop.mjs",
    "prebuild:win": "node tools/prebuild.mjs",
    "build:win": "electron-builder --win --x64 --dir",
    "prebuild:linux": "node tools/prebuild.mjs",
    "build:linux": "electron-builder --linux --x64 --dir"
  },
  "devDependencies": {
    "cannon-es": "0.20.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "playwright-core": "^1.65.0",
    "sharp": "0.35.5",
    "three": "0.160.0"
  },
  "productName": "Golden Grab",
  "author": "Golden Grab",
  "main": "electron/main.js",
  "dependencies": {
    "steamworks.js": "0.4.0"
  },
  "build": {
    "appId": "com.goldengrab.game",
    "productName": "Golden Grab",
    "copyright": "Golden Grab",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "index.html",
      "styles.css",
      "package.json",
      "src/**/*",
      "vendor/**/*",
      "electron/*.js",
      "electron/package.json",
      "electron/icon.png",
      "assets/models/*.glb",
      "assets/textures/*.webp",
      "!node_modules/steamworks.js/dist/osx/**",
      "!node_modules/steamworks.js/*.md",
      "!node_modules/steamworks.js/*.d.ts"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/steamworks.js/dist/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "files": [
        "index.html",
        "styles.css",
        "package.json",
        "src/**/*",
        "vendor/**/*",
        "electron/*.js",
        "electron/package.json",
        "electron/icon.png",
        "assets/models/*.glb",
        "assets/textures/*.webp",
        "!node_modules/steamworks.js/dist/osx/**",
        "!node_modules/steamworks.js/*.md",
        "!node_modules/steamworks.js/*.d.ts",
        "!node_modules/steamworks.js/dist/linux64/**"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon-512.png",
      "category": "Game",
      "executableName": "golden-grab",
      "files": [
        "index.html",
        "styles.css",
        "package.json",
        "src/**/*",
        "vendor/**/*",
        "electron/*.js",
        "electron/package.json",
        "electron/icon.png",
        "assets/models/*.glb",
        "assets/textures/*.webp",
        "!node_modules/steamworks.js/dist/osx/**",
        "!node_modules/steamworks.js/*.md",
        "!node_modules/steamworks.js/*.d.ts",
        "!node_modules/steamworks.js/dist/win64/**"
      ]
    }
  }
}
